NODE_ENV=development

# Database
DATABASE_URL=postgresql://schoolos:password@localhost:5432/schoolos

# Redis
REDIS_URL=redis://localhost:6379

# JWT — min 32 chars for JWT_SECRET and SUPERADMIN_JWT_SECRET
JWT_SECRET=change_me_to_a_32_character_secret_minimum
JWT_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d
SUPERADMIN_JWT_SECRET=change_me_to_another_32_character_secret

# Server ports
PORT=3000
SUPERADMIN_PORT=3001

# Razorpay — student billing (parent -> school)
RAZORPAY_STUDENT_KEY_ID=rzp_test_xxx
RAZORPAY_STUDENT_KEY_SECRET=xxx
RAZORPAY_STUDENT_WEBHOOK_SECRET=xxx

# Razorpay — SaaS billing (school -> SchoolOS)
RAZORPAY_SAAS_KEY_ID=rzp_test_xxx
RAZORPAY_SAAS_KEY_SECRET=xxx
RAZORPAY_SAAS_WEBHOOK_SECRET=xxx

# Stripe — student billing
STRIPE_STUDENT_SECRET_KEY=sk_test_xxx
STRIPE_STUDENT_WEBHOOK_SECRET=whsec_xxx

# Stripe — SaaS billing
STRIPE_SAAS_SECRET_KEY=sk_test_xxx
STRIPE_SAAS_WEBHOOK_SECRET=whsec_xxx

# AWS / S3
AWS_ACCESS_KEY_ID=xxx
AWS_SECRET_ACCESS_KEY=xxx
AWS_REGION=ap-south-1
AWS_S3_BUCKET_PROD=schoolos-prod
AWS_S3_BUCKET_BACKUPS=schoolos-backups

# OpenAI
OPENAI_API_KEY=sk-xxx
# Notifications (optional in dev)
SENDGRID_API_KEY=SG.xxx
TWILIO_ACCOUNT_SID=ACxxx
TWILIO_AUTH_TOKEN=xxx
FCM_SERVER_KEY=xxx
