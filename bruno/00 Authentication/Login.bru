meta {
  name: Login
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/auth/login
  body: json
}

headers {
  Content-Type: application/json
  x-tenant-id: schoolos-platform
}

body:json {
{
  "email": "admin@bytebeamtech.com",
  "password": "{{superadminPassword}}"
}
}

tests {
  test("Status 200", function () {
    expect(res.status).to.equal(200);
  });

  bru.setEnvVar("accessToken", res.body.accessToken);
  bru.setEnvVar("refreshToken", res.body.refreshToken);
  bru.setEnvVar("tenantId", res.body.user.tenantId);
  bru.setEnvVar("userId", res.body.user.id);
  bru.setEnvVar("role", res.body.user.role);
}
