model TenantSettings {
  tenantId               String   @id
  enableDirectAdmission  Boolean  @default(true)
  enableOnlineAdmissions Boolean  @default(false)
  enableLeadScoring      Boolean  @default(false)
  enableAutoRouting      Boolean  @default(true)
  admissionApprovalLevel Int      @default(1)
  updatedAt              DateTime @updatedAt
}

model Role {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  isSystem    Boolean  @default(false)
  permissions String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]

  @@index([tenantId])
}

model Campaign {
  id        String    @id @default(cuid())
  tenantId  String
  branchId  String?
  name      String
  type      String
  startDate DateTime
  endDate   DateTime?
  budget    Float?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  leads     Lead[]

  @@index([tenantId, branchId])
}

model LeadSource {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  leads     Lead[]

  @@index([tenantId])
}

model Lead {
  id                 String                @id @default(cuid())
  tenantId           String
  branchId           String
  parentName         String
  parentPhone        String
  parentEmail        String?
  studentName        String?
  gradeInterestedIn  String
  expectedEnrollYear Int
  sourceId           String?
  campaignId         String?
  assignedToId       String?
  referredById       String?
  status             LeadStatus            @default(NEW)
  temperature        LeadTemperature       @default(WARM)
  applicationId      String?               @unique
  notes              Json?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  tasks              FollowUpTask[]
  interactions       InteractionLog[]
  application        AdmissionApplication? @relation(fields: [applicationId], references: [id])
  assignedTo         User?                 @relation("AssignedLeads", fields: [assignedToId], references: [id])
  campaign           Campaign?             @relation(fields: [campaignId], references: [id])
  referredBy         User?                 @relation("ReferredLeads", fields: [referredById], references: [id])
  source             LeadSource?           @relation(fields: [sourceId], references: [id])

  @@index([tenantId, branchId, status])
  @@index([parentPhone])
}

model InteractionLog {
  id           String          @id @default(cuid())
  tenantId     String
  leadId       String
  type         InteractionType
  direction    String
  summary      String
  mediaUrl     String?
  handledById  String
  interactedAt DateTime        @default(now())
  handledBy    User            @relation(fields: [handledById], references: [id])
  lead         Lead            @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
}

model FollowUpTask {
  id           String     @id @default(cuid())
  tenantId     String
  leadId       String
  assignedToId String
  title        String
  description  String?
  dueDate      DateTime
  status       TaskStatus @default(PENDING)
  completedAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  assignedTo   User       @relation(fields: [assignedToId], references: [id])
  lead         Lead       @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([tenantId, assignedToId, status])
}

model ApplicationApproval {
  id            String               @id @default(cuid())
  tenantId      String
  applicationId String
  tier          ApprovalTier
  status        ApprovalStatus       @default(PENDING)
  reviewedById  String?
  comments      String?
  reviewedAt    DateTime?
  createdAt     DateTime             @default(now())
  application   AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  reviewedBy    User?                @relation(fields: [reviewedById], references: [id])

  @@index([applicationId])
  @@index([tenantId, tier, status])
}

enum LeadStatus {
  NEW
  CONTACTED
  TOUR_SCHEDULED
  ASSESSMENT_PENDING
  APPLIED
  LOST
}

enum LeadTemperature {
  COLD
  WARM
  HOT
}

enum InteractionType {
  CALL
  WHATSAPP
  EMAIL
  SMS
  MEETING
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ApprovalTier {
  DOCUMENT_VERIFICATION
  FINANCIAL_REVIEW
  PRINCIPAL_SIGNOFF
}
