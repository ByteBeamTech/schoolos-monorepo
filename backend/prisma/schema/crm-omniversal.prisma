// ====================== ENUMS ======================
enum LeadStatus {
  NEW
  CONTACTED
  TOUR_SCHEDULED
  ASSESSMENT_PENDING
  APPLIED
  LOST
}

enum LeadTemperature {
  COLD
  WARM
  HOT
}

enum InteractionType {
  CALL
  WHATSAPP
  EMAIL
  SMS
  MEETING
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ApprovalTier {
  DOCUMENT_VERIFICATION
  FINANCIAL_REVIEW
  PRINCIPAL_SIGNOFF
}

// ====================== OMNIVERSAL CONTROL (RBAC & SETTINGS) ======================

model TenantSettings {
  tenantId String @id // 1:1 with Tenant

  enableDirectAdmission  Boolean @default(true)
  enableOnlineAdmissions Boolean @default(false)
  enableLeadScoring      Boolean @default(false)
  enableAutoRouting      Boolean @default(true)

  admissionApprovalLevel Int @default(1) // 0=None, 1=Principal, 2=VP+Principal

  updatedAt DateTime @updatedAt
}

model Role {
  id       String  @id @default(cuid())
  tenantId String
  name     String
  isSystem Boolean @default(false)

  permissions String[] // Array of capability strings (e.g., "crm:lead:read")

  // Note: Add 'roleId String?' and 'role Role? @relation...' to your existing User model.
  users User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

// ====================== CRM: MARKETING & LEADS ======================

model Campaign {
  id       String  @id @default(cuid())
  tenantId String
  branchId String?

  name      String
  type      String
  startDate DateTime
  endDate   DateTime?
  budget    Float?

  leads     Lead[]
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([tenantId, branchId])
}

model LeadSource {
  id       String @id @default(cuid())
  tenantId String
  name     String // e.g., Facebook, Referral, Walk-in

  leads Lead[]

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@index([tenantId])
}

model Lead {
  id       String @id @default(cuid())
  tenantId String
  branchId String

  parentName         String
  parentPhone        String
  parentEmail        String?
  studentName        String?
  gradeInterestedIn  String
  expectedEnrollYear Int

  sourceId String?
  source   LeadSource? @relation(fields: [sourceId], references: [id])

  campaignId String?
  campaign   Campaign? @relation(fields: [campaignId], references: [id])

  assignedToId String?
  assignedTo   User?   @relation("AssignedLeads", fields: [assignedToId], references: [id])
  referredById String?
  referredBy   User?   @relation("ReferredLeads", fields: [referredById], references: [id])

  status      LeadStatus      @default(NEW)
  temperature LeadTemperature @default(WARM)

  applicationId String?               @unique
  application   AdmissionApplication? @relation(fields: [applicationId], references: [id])

  interactions InteractionLog[]
  tasks        FollowUpTask[]
  notes        Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, branchId, status])
  @@index([parentPhone])
}

model InteractionLog {
  id       String @id @default(cuid())
  tenantId String
  leadId   String
  lead     Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  type      InteractionType
  direction String // INBOUND / OUTBOUND
  summary   String
  mediaUrl  String?

  handledById String
  handledBy   User   @relation(fields: [handledById], references: [id])

  interactedAt DateTime @default(now())

  @@index([leadId])
}

model FollowUpTask {
  id       String @id @default(cuid())
  tenantId String
  leadId   String
  lead     Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  assignedToId String
  assignedTo   User   @relation(fields: [assignedToId], references: [id])

  title       String
  description String?
  dueDate     DateTime
  status      TaskStatus @default(PENDING)
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId, assignedToId, status])
}

// ====================== ADMISSION APPROVAL ENGINE ======================

model ApplicationApproval {
  id       String @id @default(cuid())
  tenantId String

  applicationId String
  application   AdmissionApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  tier   ApprovalTier
  status ApprovalStatus @default(PENDING)

  reviewedById String?
  reviewedBy   User?   @relation(fields: [reviewedById], references: [id])
  comments     String?

  reviewedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([applicationId])
  @@index([tenantId, tier, status])
}
