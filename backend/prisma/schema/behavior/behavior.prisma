// backend/prisma/schema/behavior/behavior.prisma

model BehaviorRecord {
  id               String           @id @default(cuid())
  tenantId         String
  studentId        String
  type             BehaviorType
  category         String
  title            String?
  description      String?
  severity         BehaviorSeverity @default(MEDIUM)
  actionTaken      String?
  points           Int              @default(0)
  parentNotified   Boolean          @default(false)
  followUpRequired Boolean          @default(false)
  status           BehaviorStatus   @default(OPEN)
  reportedBy       String
  incidentDate     DateTime         @db.Date
  resolvedAt       DateTime?
  resolvedBy       String?
  resolutionNote   String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([studentId])
  @@index([tenantId, studentId])
  @@index([tenantId, type])
  @@index([incidentDate])
}

enum BehaviorType {
  POSITIVE
  NEGATIVE
  NEUTRAL
}

enum BehaviorSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum BehaviorStatus {
  OPEN
  RESOLVED
  ESCALATED
}
