// ============================================================
// LIBRARY — ADR-LIB-001 (Domain Architecture Freeze, APPROVED FOR
// IMPLEMENTATION). This file is being migrated in phases per the
// implementation roadmap in docs/architecture/library/
// LIBRARY_DOMAIN_ARCHITECTURE_FREEZE.md. Do not add aggregates or
// fields outside the current phase's scope without amending the ADR.
// ============================================================

// ---------- Phase 1: catalog taxonomy + branch config ----------
// Pure additive schema -- Book/BookIssue behavior is unchanged in
// this phase. categoryId/publisherId/authors on Book are nullable so
// existing rows and existing service code keep working unmodified.
// The free-text Book.author/Book.publisher columns are NOT removed in
// this phase (kept for backward compatibility) -- they are cut over
// to Author/Publisher/BookAuthor and dropped in Phase 2, alongside
// the Book -> BookCopy split, per the frozen roadmap.

model BookCategory {
  id       String  @id @default(cuid())
  tenantId String
  parentId String?

  name      String
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  parent   BookCategory?  @relation("BookCategoryToParent", fields: [parentId], references: [id])
  children BookCategory[] @relation("BookCategoryToParent")
  books    Book[]

  @@unique([tenantId, parentId, name])
  @@index([tenantId])
  @@index([tenantId, parentId])
}

model Author {
  id       String @id @default(cuid())
  tenantId String

  name      String
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  books BookAuthor[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model Publisher {
  id       String @id @default(cuid())
  tenantId String

  name      String
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  books Book[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

// Join table for Book <-> Author (co-authorship). No surrogate id --
// the composite key IS the fact being recorded, consistent with how
// other pure join tables in this schema are modeled.
model BookAuthor {
  bookId   String
  authorId String

  book   Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)
  author Author @relation(fields: [authorId], references: [id], onDelete: Restrict)

  @@id([bookId, authorId])
  @@index([authorId])
}

model Rack {
  id       String @id @default(cuid())
  tenantId String
  branchId String

  code      String
  name      String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  branch  Branch  @relation(fields: [branchId], references: [id])
  shelves Shelf[]

  @@unique([tenantId, branchId, code])
  @@index([tenantId, branchId])
}

model Shelf {
  id       String @id @default(cuid())
  tenantId String
  rackId   String

  code      String
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  rack Rack @relation(fields: [rackId], references: [id], onDelete: Restrict)
  copies BookCopy[]

  @@unique([rackId, code])
  @@index([tenantId])
}

// Per-branch Library configuration (ADR-LIB-001 section 1 -- "Library" is
// not modeled as its own aggregate; this is the config surface that
// replaced it). One row per (tenantId, branchId), created on demand
// with defaults rather than provisioned eagerly for every branch.
model LibraryBranchSettings {
  id       String @id @default(cuid())
  tenantId String
  branchId String

  loanDurationDays          Int     @default(14)
  maxRenewals               Int     @default(2)
  maxActiveLoansPerBorrower Int     @default(1)
  reservationHoldHours      Int     @default(48)
  fineRatePerDay            Decimal @default(2.00) @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  branch Branch @relation(fields: [branchId], references: [id])

  @@unique([tenantId, branchId])
  @@index([tenantId])
}

// ---------- Phase 2: physical inventory core ----------
// ADR-LIB-001 §3: Book (catalog) -> BookCopy (physical item, branch-
// scoped) -> BookIssue (references copyId, not bookId).

model BookCopy {
  id       String @id @default(cuid())
  tenantId String
  branchId String
  bookId   String

  barcode String
  rfidTag String?
  shelfId String?

  status    BookCopyStatus @default(AVAILABLE)
  condition String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  book   Book        @relation(fields: [bookId], references: [id], onDelete: Restrict)
  branch Branch      @relation(fields: [branchId], references: [id])
  shelf  Shelf?      @relation(fields: [shelfId], references: [id])
  issues BookIssue[]

  // NOTE (ADR-LIB-001 §3 invariant 2): a BookCopy may have at most one
  // OPEN issue at a time. Prisma cannot express a partial unique index
  // (WHERE "status" = 'ISSUED') declaratively -- it is created via raw
  // SQL in this phase's migration
  // (prisma/migrations/20260727090000_library_phase2_bookcopy_core/
  // migration.sql, index "BookIssue_copyId_open_issue_key"). This is
  // the structural fix for the double-issue race (audit finding C1) --
  // do not remove it, and do not assume `prisma migrate dev`/`db pull`
  // will regenerate it, since it is invisible to `schema.prisma`.
  @@unique([tenantId, barcode])
  @@unique([rfidTag])
  @@index([tenantId, branchId, status])
  @@index([bookId])
}

// Barcode number generator -- identical shape to InvoiceSequence /
// ReceiptSequence (student-billing/sequences.prisma), reusing the
// same atomic-increment discipline for the same reason (ADR-LIB-001
// §12).
model BarcodeSequence {
  id       String @id @default(cuid())
  tenantId String
  branchId String

  year       Int
  lastNumber Int @default(0)

  branch Branch @relation(fields: [branchId], references: [id])

  @@unique([tenantId, branchId, year])
  @@index([tenantId, branchId])
}

model Book {
  id       String @id @default(cuid())
  tenantId String
  isbn     String?
  title    String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  categoryId      String?
  publisherId     String?
  category        BookCategory? @relation(fields: [categoryId], references: [id])
  publisherRecord Publisher?    @relation(fields: [publisherId], references: [id])
  authors         BookAuthor[]
  copies          BookCopy[]

  @@index([tenantId])
  @@index([isbn])
  @@index([categoryId])
  @@index([publisherId])
}

// ADR-LIB-001 §2/§5/§7 -- re-pointed to copyId (not bookId).
// Borrower is polymorphic (BorrowerType + borrowerId, no FK -- see
// ADR §2 for why) with a point-in-time snapshot of name/branch/
// display-id, so history stays accurate independent of what happens
// to the Student/Staff row afterward (transfer, TC, alumni, etc.).
// branchId is snapshotted from the copy's branch at issue time (ADR
// §5), not a live join -- a copy transferred between branches later
// must not silently rewrite past issue history.
model BookIssue {
  id       String @id @default(cuid())
  tenantId String
  branchId String

  copyId String

  borrowerType              BorrowerType
  borrowerId                String
  borrowerNameSnapshot      String
  borrowerBranchIdSnapshot  String?
  borrowerDisplayIdSnapshot String?

  issuedAt     DateTime        @default(now())
  dueDate      DateTime
  returnedAt   DateTime?
  renewalCount Int             @default(0)
  status       BookIssueStatus @default(ISSUED)

  // Fine fields predate Phase 2 and are left untouched here -- the
  // Fine/LibraryChargeRequest redesign (ADR §9) is Phase 4 scope.
  fine     Decimal? @db.Decimal(10, 2)
  finePaid Boolean  @default(false)

  issuedBy   String
  returnedBy String?

  copy BookCopy @relation(fields: [copyId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([tenantId, branchId, status, dueDate])
  @@index([copyId])
  @@index([borrowerType, borrowerId])
}
