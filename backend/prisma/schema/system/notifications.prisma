// path: apps/schoolos/backend/prisma/schema/system/notifications.prisma

model Notification {
  id          String              @id @default(cuid())
  tenantId    String
  recipientId String?
  channel     NotificationChannel
  status      NotificationStatus  @default(PENDING)
  subject     String?
  body        String
  templateId  String?
  data        Json?               @default("{}")
  sentAt      DateTime?
  deliveredAt DateTime?
  readAt      DateTime?
  failReason  String?
  createdAt   DateTime            @default(now())

  // Relations
  tenant Tenant @relation(fields: [tenantId], references: [id])

  // EXISTING INDEXES
  @@index([tenantId])
  @@index([recipientId])
  @@index([status])
  // NEW PERFORMANCE INDEXES (The Fix for 12GB RAM)
  // 1. डैशबोर्ड पर "Pending/Failed" नोटिफिकेशन जल्दी लोड करने के लिए
  @@index([tenantId, status])
  // 2. मोबाइल ऐप/पैनल पर "My Notifications" को फ़ास्ट करने के लिए
  @@index([tenantId, recipientId, status])
  // 3. पुराने नोटिफिकेशन साफ़ करने वाले क्रॉन जॉब्स (Cleanup Jobs) के लिए
  @@index([createdAt])
}

model FraudAlert {
  id          String             @id @default(cuid())
  tenantId    String
  severity    FraudAlertSeverity
  status      FraudAlertStatus   @default(OPEN)
  ruleId      String
  ruleName    String
  description String
  entityType  String
  entityId    String
  evidence    Json?
  resolvedAt  DateTime?
  resolvedBy  String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, status])
  @@index([severity])
  @@index([createdAt]) // ← Added: For auditing fraud trends over time
}

model StudentDailyCount {
  id        String   @id @default(cuid())
  tenantId  String
  date      DateTime @db.Date
  count     Int
  createdAt DateTime @default(now())

  @@unique([tenantId, date])
  @@index([tenantId])
  @@index([date]) // ← Added: For cross-tenant analytics reports
}
