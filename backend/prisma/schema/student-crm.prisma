model Family {
  id           String                 @id @default(cuid())
  tenantId     String
  branchId     String?
  familyName   String?
  createdAt    DateTime               @default(now())
  applications AdmissionApplication[]
  students     Student[]

  @@index([tenantId])
  @@index([tenantId, branchId])
}

model StudentRelationship {
  id           String       @id @default(cuid())
  tenantId     String
  branchId     String?
  studentId    String
  relatedToId  String
  type         RelationType
  isVerified   Boolean      @default(false)
  verifiedById String?
  metadata     Json?
  notes        String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  relatedTo    Student      @relation("RelatedTo", fields: [relatedToId], references: [id])
  student      Student      @relation("StudentRelations", fields: [studentId], references: [id])

  @@unique([studentId, relatedToId])
  @@index([tenantId])
  @@index([tenantId, branchId, studentId])
  @@index([tenantId, branchId, relatedToId])
}

model AdmissionApplication {
  id               String                @id @default(cuid())
  tenantId         String
  branchId         String
  firstName        String
  lastName         String
  photoUrl         String?
  dob              DateTime
  gender           String
  aadharHash       String?
  aadharLast4      String?
  phone            String?
  email            String?
  crmNo            String                @unique
  admissionMode    AdmissionMode
  familyId         String?
  linkedRelativeId String?
  relationType     RelationType?
  duplicateOfId    String?
  status           ApplicationStatus     @default(PENDING)
  formDetails      Json?
  notes            Json?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  isStaffWard      Boolean               @default(false)
  referredById     String?
  staffParentId    String?
  Family           Family?               @relation(fields: [familyId], references: [id])
  referredBy       User?                 @relation("ReferredApplications", fields: [referredById], references: [id])
  staffParent      User?                 @relation("StaffChildren", fields: [staffParentId], references: [id])
  approvals        ApplicationApproval[]
  lead             Lead?

  @@index([tenantId, branchId])
}
