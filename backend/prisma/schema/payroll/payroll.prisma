model PayrollStructure {
  id              String         @id @default(cuid())
  tenantId        String
  staffId         String         @unique
  basicSalary     Decimal        @db.Decimal(12, 2)
  hra             Decimal        @default(0) @db.Decimal(12, 2)
  da              Decimal        @default(0) @db.Decimal(12, 2)
  ta              Decimal        @default(0) @db.Decimal(12, 2)
  otherAllowances Decimal        @default(0) @db.Decimal(12, 2)
  pfEmployee      Decimal        @default(0) @db.Decimal(12, 2)
  pfEmployer      Decimal        @default(0) @db.Decimal(12, 2)
  esi             Decimal        @default(0) @db.Decimal(12, 2)
  tds             Decimal        @default(0) @db.Decimal(12, 2)
  effectiveFrom   DateTime       @db.Date
  currency        Currency       @default(INR)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  entries         PayrollEntry[]

  @@index([tenantId])
}

model PayrollEntry {
  id              String           @id @default(cuid())
  tenantId        String
  staffId         String
  structureId     String
  month           Int
  year            Int
  workingDays     Int              @default(26)
  presentDays     Int              @default(26)
  basicPaid       Decimal          @db.Decimal(12, 2)
  hraPaid         Decimal          @default(0) @db.Decimal(12, 2)
  daPaid          Decimal          @default(0) @db.Decimal(12, 2)
  taPaid          Decimal          @default(0) @db.Decimal(12, 2)
  otherAllowances Decimal          @default(0) @db.Decimal(12, 2)
  grossSalary     Decimal          @db.Decimal(12, 2)
  pfDeduction     Decimal          @default(0) @db.Decimal(12, 2)
  esiDeduction    Decimal          @default(0) @db.Decimal(12, 2)
  tdsDeduction    Decimal          @default(0) @db.Decimal(12, 2)
  otherDeductions Decimal          @default(0) @db.Decimal(12, 2)
  netSalary       Decimal          @db.Decimal(12, 2)
  status          PayrollStatus    @default(DRAFT)
  paidAt          DateTime?
  payslipUrl      String?
  createdBy       String
  createdAt       DateTime         @default(now())
  structure       PayrollStructure @relation(fields: [structureId], references: [id])

  @@unique([tenantId, staffId, month, year])
  @@index([tenantId])
  @@index([staffId])
}

enum PayrollStatus {
  DRAFT
  APPROVED
  PAID
  CANCELLED
}
