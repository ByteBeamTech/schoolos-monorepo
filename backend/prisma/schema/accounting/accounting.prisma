model Expense {
  id          String          @id @default(cuid())
  tenantId    String
  category    ExpenseCategory
  amount      Decimal         @db.Decimal(12, 2)
  currency    Currency        @default(INR)
  description String
  vendorId    String?
  receiptUrl  String?
  expenseDate DateTime        @db.Date
  approvedBy  String?
  createdBy   String
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  vendor      Vendor?         @relation(fields: [vendorId], references: [id])

  @@index([tenantId])
  @@index([expenseDate])
  @@index([category])
}

model Vendor {
  id          String    @id @default(cuid())
  tenantId    String
  name        String
  contactName String?
  phone       String?
  email       String?
  address     Json?
  gstNumber   String?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  expenses    Expense[]

  @@index([tenantId])
}
