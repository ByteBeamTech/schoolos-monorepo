model StaffProfile {
  id            String    @id @default(cuid())
  tenantId      String
  userId        String    @unique
  employeeId    String
  designation   String
  department    String?
  dateOfJoining DateTime
  dateOfBirth   DateTime?
  gender        Gender?
  qualification String?
  experience    Int?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  user          User      @relation(fields: [userId], references: [id])

  @@unique([tenantId, employeeId])
  @@index([tenantId])
}

// Which subjects a teacher is qualified/preferred to teach
// Set at staff creation time; used to pre-filter dropdowns in academics
model TeacherSubjectPreference {
  id        String   @id @default(cuid())
  tenantId  String
  staffId   String // StaffProfile.id
  subjectId String // Subject.id
  createdAt DateTime @default(now())

  @@unique([tenantId, staffId, subjectId])
  @@index([tenantId, staffId])
}
