model User {
  id                   String                 @id @default(cuid())
  tenantId             String
  email                String
  phone                String?
  passwordHash         String?
  firstName            String
  lastName             String
  role                 UserRole
  isActive             Boolean                @default(true)
  isEmailVerified      Boolean                @default(false)
  isPhoneVerified      Boolean                @default(false)
  avatarUrl            String?
  lastLoginAt          DateTime?
  mfaEnabled           Boolean                @default(false)
  mfaSecret            String?
  preferences          Json?                  @default("{}")
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  deletedAt            DateTime?
  roleId               String?
  referredApplications AdmissionApplication[] @relation("ReferredApplications")
  staffChildren        AdmissionApplication[] @relation("StaffChildren")
  applicationApprovals ApplicationApproval[]
  auditLogs            AuditLog[]
  discountApprovals    DiscountApproval[]     @relation("Approver")
  discountRequests     DiscountApproval[]     @relation("Requester")
  followUpTasks        FollowUpTask[]
  interactionLogs      InteractionLog[]
  assignedLeads        Lead[]                 @relation("AssignedLeads")
  referredLeads        Lead[]                 @relation("ReferredLeads")
  oauthAccounts        OAuthAccount[]
  sessions             Session[]
  staffProfile         StaffProfile?
  customRole           Role?                  @relation(fields: [roleId], references: [id])
  tenant               Tenant                 @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([email])
  @@index([role])
}

model Session {
  id           String    @id @default(cuid())
  userId       String
  refreshToken String    @unique
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([refreshToken])
}

model OAuthAccount {
  id             String    @id @default(cuid())
  userId         String
  provider       String
  providerUserId String
  accessToken    String?
  refreshToken   String?
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id])

  @@unique([provider, providerUserId])
  @@index([userId])
}
