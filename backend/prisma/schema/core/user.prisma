// ==========================================================
// 🏫 SCHOOLOS MASTER USER & AUTH SCHEMA (v2.2 FINAL)
// ==========================================================

model User {
  id           String   @id @default(cuid())
  tenantId     String
  email        String
  phone        String? // 📞 Service layer ensures NULL if empty
  passwordHash String?
  firstName    String
  lastName     String
  role         UserRole

  // 🛡️ Lifecycle & Security
  isActive  Boolean   @default(true)
  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  isEmailVerified Boolean   @default(false)
  isPhoneVerified Boolean   @default(false)
  avatarUrl       String?
  lastLoginAt     DateTime?
  mfaEnabled      Boolean   @default(false)
  mfaSecret       String?
  preferences     Json?     @default("{}")
  sessions        Session[]
  roleId          String?
  customRole      Role?     @relation(fields: [roleId], references: [id])
  tenant          Tenant    @relation(fields: [tenantId], references: [id])

  staff          Staff?
  branchMappings UserBranch[]

  // 🤝 CRM & Admission Master Handshake
  createdApplications  AdmissionApplication[] @relation("CreatedApplications")
  updatedApplications  AdmissionApplication[] @relation("UpdatedApplications")
  referredApplications AdmissionApplication[] @relation("ReferredApplications")
  staffChildren        AdmissionApplication[] @relation("StaffChildren")

  // 👤 Admission Audit Trail
  // Must match @relation names in AdmissionActivity/StepLog

  // 🔗 Other Module Relations
  applicationApprovals  ApplicationApproval[]
  auditLogs             AuditLog[]
  discountApprovals     DiscountApproval[]      @relation("Approver")
  discountRequests      DiscountApproval[]      @relation("Requester")
  followUpTasks         FollowUpTask[]
  interactionLogs       InteractionLog[]
  assignedLeads         Lead[]                  @relation("AssignedLeads")
  referredLeads         Lead[]                  @relation("ReferredLeads")
  oauthAccounts         OAuthAccount[]
  performedActivities   AdmissionActivity[]     @relation("PerformedActivities")
  updatedStepLogs       AdmissionStepLog[]      @relation("UpdatedStepLogs")
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  //calendar module relaion
  calendarEventsCreated AcademicCalendarEvent[] @relation("EventCreator")

  discountsCreated Discount[] @relation("DiscountCreator")
  discountsRevoked Discount[] @relation("DiscountRevoker")

  lateFeesWaived   LateFee[] @relation("LateFeeWaiver")
  lateFeesApplied  LateFee[] @relation("LateFeeApplier")
  lateFeesReversed LateFee[] @relation("LateFeeReverser")
  lateFeeRulesCreated LateFeeRule[]
  lateFeeWaiversGranted LateFeeWaiver[]

  studentProfile  Student? // Back-relation for Student.user
  guardianProfile Guardian? @relation("GuardianUser") // Back-relation for Guardian.user
  // 🔥 HIGH-PERFORMANCE CONSTRAINTS & INDEXES

  // 🔐 Uniqueness Scoped to Tenant
  @@unique([tenantId, email])
  @@unique([tenantId, phone])
  // ⚡ Auth & System Performance
  @@index([tenantId])
  @@index([tenantId, email, isActive]) // Auth query booster
  @@index([tenantId, isDeleted]) // Soft delete query booster
  // 🚀 THE SCALING INDEX
  // Fast lookup for active Teachers/Admins in a branch/tenant
  @@index([tenantId, role, isActive])
  @@index([role])
}

model UserBranch {
  id String @id @default(cuid())

  tenantId String
  userId   String
  branchId String

  isDefault Boolean @default(false)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])
  branch Branch @relation(fields: [branchId], references: [id])

  @@unique([userId, branchId])
  @@index([tenantId])
  @@index([userId])
  @@index([branchId])
}

// ================== AUTH SUPPORT MODELS ==================

model Session {
  id           String    @id @default(cuid())
  userId       String
  refreshToken String    @unique
  userAgent    String?
  ipAddress    String?
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())
  user         User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([refreshToken])
}

model OAuthAccount {
  id             String    @id @default(cuid())
  userId         String
  provider       String
  providerUserId String
  accessToken    String?
  refreshToken   String?
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  user           User      @relation(fields: [userId], references: [id])

  @@unique([provider, providerUserId])
  @@index([userId])
}
