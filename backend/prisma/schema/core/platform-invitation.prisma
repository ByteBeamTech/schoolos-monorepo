// core/platform-invitation.prisma
//
// Platform-staff invitation flow (Administration > Invitations).
// Deliberately separate from the tenant onboarding flow -- this invites
// a person to become SchoolOS's own platform staff (SUPER_ADMIN /
// SAAS_OWNER / ACCOUNT_MANAGER), not a school admin.

model PlatformInvitation {
  id         String    @id @default(cuid())
  email      String
  role       UserRole
  department String?
  token      String    @unique
  status     String    @default("PENDING") // PENDING | ACCEPTED | CANCELLED | EXPIRED
  invitedBy  String
  expiresAt  DateTime
  acceptedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([email])
  @@index([token])
  @@index([status])
}
