model Tenant {
  id        String  @id @default(cuid())
  name      String
  slug      String  @unique
  subdomain String? @unique // 🔥 URL: stmarys.schoolos.com
  domain    String? @unique // 🔥 Custom: school.com

  // --- 🌍 Localization & Smart Scheduling ---
  timezone String   @default("Asia/Kolkata")
  locale   String   @default("en-IN")
  region   Region   @default(IN)
  currency Currency @default(INR)

  // 🔥 NEXT-GEN SCHEDULER FIELDS (Scalability ke liye)
  nextRunAt       DateTime? // Performance Indexing
  lastRunAt       DateTime? // Disaster Recovery
  schedulerConfig Json?     @default("{\"feeReminderTime\": \"08:00\", \"attendanceTime\": \"17:00\"}")

  // --- 🎨 Branding & UI ---
  logoUrl        String?
  faviconUrl     String?
  primaryColor   String? @default("#1E40AF")
  secondaryColor String? @default("#DBEAFE")

  // --- 📊 Quotas & Status ---
  status       TenantStatus @default(TRIAL)
  // @deprecated (PR-2, COMM-002/COMM-004 gap fill): written at onboarding
  // (onboarding.service.ts) but never read by enforcement — License.maxStudents
  // (see core/license/license.service.ts) is the sole enforcement source of
  // truth. Left writable to avoid breaking onboarding's existing write path;
  // full removal + onboarding refactor to stop writing this is PR-4 scope.
  maxStudents  Int          @default(500)
  storageLimit Int          @default(1024) // MB mein
  smsBalance   Int          @default(0)

  // PR-2 (COMM-005 gap fill): routing flag for hybrid purchasing model.
  // Field-only — no runtime routing behavior wired to it yet (PR-4/5 scope).
  commercialTier CommercialTier @default(SELF_SERVICE)

  // --- Contact & Business ---
  contactEmail     String
  contactPhone     String?
  address          Json?
  gstNumber        String?
  panNumber        String?
  // @deprecated (PR-2, COMM-002 gap fill): fully superseded by the License
  // model (see saas-billing.prisma). Confirmed zero read/write usage anywhere
  // in backend/src as of PR-2 — safe to remove entirely in PR-4.
  licenseKey       String?   @unique
  // @deprecated (PR-2, COMM-002 gap fill): see licenseKey above — same status.
  licenseExpiresAt DateTime?
  settings         Json?     @default("{}")
  metadata         Json?     @default("{}")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // --- 🔗 ALL EXISTING RELATIONS (Nothing Missed) ---
  userBranches         UserBranch[]
  academicSessions     AcademicSession[]
  alumni               Alumni[]
  workflowConfigs      ApprovalWorkflowConfig[]
  auditLogs            AuditLog[]
  complaints           Complaint[]
  featureFlags         FeatureFlag[]
  features             TenantFeatureMatrix[]
  fraudAlerts          FraudAlert[]
  guardians            Guardian[]
  idCards              IDCard[]
  idCardTemplates      IDCardTemplate[]
  joiningRequests      JoiningRequest[]
  License              License[]
  notifications        Notification[]
  promotionRules       PromotionRule[]
  rolePermissions      RolePermission[]
  students             Student[]
  supportTickets       SupportTicket[]
  users                User[]
  visitors             Visitor[]
  behaviorRecords      BehaviorRecord[]
  communicationLogs    CommunicationLog[]
  bulkNotificationJobs BulkNotificationJob[]
  discountCategories   DiscountCategory[]
  paymentAllocations   PaymentAllocation[]
  feeHeads             FeeHead[]
  lateFeeRules         LateFeeRule[]
  subjects             Subject[]
  staffMembers         Staff[]                    @relation("TenantMembers")
  staffProfiles        StaffProfile[]             @relation("TenantProfiles")
  teacherPreferences   TeacherSubjectPreference[] @relation("TenantTeacherPrefs")
  admissions           AdmissionApplication[]
  families             Family[]
  documents            Document[]
  transportRoutes      TransportRoute[]
  branches             Branch[]

  // TRN-SCH-001A — additive target Transport domain (coexists with legacy
  // transportRoutes above; see transport/transport-domain.prisma)
  stops                       Stop[]
  routes                      Route[]
  routeStops                  RouteStop[]
  transportStopPricing        TransportStopPricing[]
  studentTransportAssignments StudentTransportAssignment[]
  vehicles                    Vehicle[]
  drivers                     Driver[]
  conductors                  Conductor[]
  tripSchedules               TripSchedule[]
  trips                       Trip[]
  tripAttendance              TripAttendance[]
  tripIncidents               TripIncident[]
  fuelLogs                    FuelLog[]
  maintenanceRecords          Maintenance[]
  complianceItems             ComplianceItem[]
  transportSettings           TransportSettings[]
  cronLogs                    CronExecutionLog[]
  jobSchedules                TenantJobSchedule[]
  calendarEvents              AcademicCalendarEvent[]
  NotificationSetting         NotificationSetting?

  subscriptions      TenantSubscription[]
  subscriptionEvents SubscriptionEvent[]
  tenantAddons       TenantAddon[]

  // --- ⚡ Speed Indices ---
  @@index([slug])
  @@index([subdomain])
  @@index([status])
  @@index([region])
  @@index([nextRunAt]) // Performance index for scheduler
}

// =========================================================================
// 🎯 ENTERPRISE CONFIG: CONTRACT-DRIVEN FEATURE CAPABILITY MATRIX
// =========================================================================
model TenantFeatureMatrix {
  id         String    @id @default(cuid())
  tenantId   String
  featureKey String // e.g., "SMS_AUTOMATION", "LMS_PREMIUM", "TRANSPORT_TRACKING"
  enabled    Boolean   @default(false)
  expiresAt  DateTime? // Contract-driven license bounds tracking
  metadata   Json? // Custom rate limits or branch allocations (e.g., {"smsQuota": 10000})
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  // 🔗 Relations
  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // 🛡️ Compound index to guarantee no duplicate capabilities are injected per school
  @@unique([tenantId, featureKey])
  // ⚡ Performance indexing for active guard routing
  @@index([tenantId, enabled])
}
