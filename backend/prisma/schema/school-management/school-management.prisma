model Branch {
  id                  String                     @id @default(cuid())
  tenantId            String
  name                String
  address             String?
  city                String?
  phone               String?
  email               String?
  principal           String?
  isActive            Boolean                    @default(true)
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  activatedAt         DateTime?
  branchCode          String?
  currentStaffCount   Int                        @default(0)
  currentStudentCount Int                        @default(0)
  deletedAt           DateTime?
  licenseId           String?
  slug                String?
  status              BranchStatus               @default(ACTIVE)
  suspendedAt         DateTime?
  License             License[]
  transportRoutes     TransportRoute[]
  // 🔥 ADD THESE BACK-RELATIONS (Mandatory for Validation)
  tenant              Tenant                     @relation(fields: [tenantId], references: [id])
  students            Student[]
  subjects            Subject[]
  admissions          AdmissionApplication[]
  staffMembers        Staff[]
  staffProfiles       StaffProfile[]
  teacherPreferences  TeacherSubjectPreference[]
  cronLogs            CronExecutionLog[]
  // Billing links (Jo humne billing.prisma mein banaye hain)
  discountCategories  DiscountCategory[]
  discounts           Discount[]
  lateFees            LateFee[]

  @@unique([tenantId, name])
  @@unique([tenantId, branchCode])
  @@index([tenantId])
  @@index([tenantId, status])
}

model TenantBranding {
  id             String   @id @default(cuid())
  tenantId       String   @unique
  primaryColor   String   @default("#1E40AF")
  secondaryColor String   @default("#DBEAFE")
  logoUrl        String?
  faviconUrl     String?
  portalTitle    String?
  tagline        String?
  updatedAt      DateTime @updatedAt
}

model TenantSecuritySettings {
  id                    String   @id @default(cuid())
  tenantId              String   @unique
  sessionTimeoutMinutes Int      @default(60)
  requireMfaForAdmins   Boolean  @default(false)
  maxLoginAttempts      Int      @default(5)
  allowedIpRanges       String[] @default([])
  enforcePasswordPolicy Boolean  @default(false)
  passwordExpiryDays    Int      @default(90)
  updatedAt             DateTime @updatedAt
}

model FeeType {
  id            String         @id @default(cuid())
  tenantId      String
  name          String
  description   String?
  isMandatory   Boolean        @default(false)
  isRecurring   Boolean        @default(true)
  createdAt     DateTime       @default(now())
  feeStructures FeeStructure[]

  @@unique([tenantId, name])
  @@index([tenantId])
}

model FeeStructure {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  classId   String
  feeTypeId String?
  frequency String
  amount    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  class     Class    @relation(fields: [classId], references: [id])
  feeType   FeeType? @relation(fields: [feeTypeId], references: [id])

  @@index([tenantId])
}
