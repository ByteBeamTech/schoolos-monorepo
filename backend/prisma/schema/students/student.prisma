// /apps/schoolos/backend/prisma/schema/students/student.prisma

model Student {
  id String @id @default(cuid())

  // 🔐 Multi-tenant Core Infrastructure
  tenantId String
  branchId String

  // 🔢 Identity
  admissionNumber String
  admissionDate   DateTime?

  // 🔄 Lifecycle & Type
  status        StudentStatus @default(ENROLLED)
  admissionType AdmissionType @default(REGULAR)

  // 🧾 Basic Info
  firstName   String
  lastName    String
  dateOfBirth DateTime?
  gender      Gender?
  bloodGroup  BloodGroup?
  religion    Religion?
  category    Category?
  photoUrl    String?

  // 🎓 Academic Hierarchy (🛡️ Added ClassId for Performance Optimization)
  classId        String
  sectionId      String?
  rollNumber     String?
  rollAssignedAt DateTime?
  academicYear   String
  sessionId      String?
  session        AcademicSession? @relation("StudentSession", fields: [sessionId], references: [id])

  // ⚙️ Flags
  isActive             Boolean @default(true)
  isDuplicate          Boolean @default(false)
  duplicateOfStudentId String?

  // 🚩 RTE Specific (Lucknow/UP Govt Compliance)
  isRte            Boolean @default(false)
  rteRegNumber     String?
  rteApplicationId String?

  // 🛡️ Board Registration Tracker (UP Board/CBSE/ICSE Compliance for Senior Classes)
  boardRegistrationNumber String?

  // ⏱ Temporal
  enrolledAt DateTime  @default(now())
  leftAt     DateTime?

  // 📦 Extra Data
  address           Json?
  metadata          Json? @default("{}")
  additionalDetails Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 🔐 Identity (Encrypted/Hashed)
  aadharHash      String?
  aadharLast4     String?
  aadharUpdatedAt DateTime?
  aadharVerified  Boolean   @default(false)

  // 🎓 APAAR (One Nation One ID)
  apaarId       String?
  apaarLinkedAt DateTime?

  // 📞 Contact
  email String?
  phone String?

  // 🏥 Health
  heightCm        Float?
  weightKg        Float?
  lastHealthCheck DateTime?

  // 🏫 Previous School Info
  previousClass          String?
  previousSchool         String?
  previousSchoolTcNumber String?

  // 🔐 User/Staff Relations
  userId String? @unique
  user   User?   @relation(fields: [userId], references: [id])

  staffId String?
  staff   Staff?  @relation("StudentStaff", fields: [staffId], references: [id])

  referredByStaffId String?
  referredByStaff   Staff?  @relation("StudentReferral", fields: [referredByStaffId], references: [id])

  // 🏫 House & Family
  houseId  String?
  house    House?  @relation("HouseStudents", fields: [houseId], references: [id])
  familyId String?
  family   Family? @relation(fields: [familyId], references: [id])

  // 🔥 ADMISSION ENGINE (The Clean Handshake)
  admissionApplicationId String?                @unique
  admissionApplication   AdmissionApplication?  @relation("PrimaryApplication", fields: [admissionApplicationId], references: [id])
  admissionApplications  AdmissionApplication[] @relation("StudentApplications")
  relativeInApplications AdmissionApplication[] @relation("CrmRelativeLink")

  // 🔗 MODULE RELATIONS
  duplicateOf Student?  @relation("DuplicateStudent", fields: [duplicateOfStudentId], references: [id])
  duplicates  Student[] @relation("DuplicateStudent")

  siblings  StudentSibling[] @relation("StudentSiblings")
  siblingOf StudentSibling[] @relation("SiblingOf")

  attendances    Attendance[]
  discounts      Discount[]
  feeAssignments FeeAssignment[]
  guardianLinks  GuardianStudent[]
  invoices       Invoice[]
  documents      Document[]
  lateFees       LateFee[]

  // Core Relational Handshakes
  class   Class    @relation(fields: [classId], references: [id]) // 🛡️ Explicit Core Class Link
  section Section? @relation(fields: [sectionId], references: [id])
  tenant  Tenant   @relation(fields: [tenantId], references: [id])
  branch  Branch   @relation(fields: [branchId], references: [id])

  relatedToMe StudentRelationship[] @relation("RelatedTo")
  relations   StudentRelationship[] @relation("StudentRelations")

  transportAssignment TransportAssignment?

  // TRN-SCH-001A — additive target Transport domain (coexists with legacy
  // transportAssignment above; see transport/transport-domain.prisma)
  transportAssignments StudentTransportAssignment[]
  tripAttendance        TripAttendance[]

  // =========================================================================
  // 🛡️ MULTI-TENANT & INTEGRITY RULES (De-risked for Data Imports)
  // =========================================================================
  @@unique([tenantId, admissionNumber])
  @@unique([tenantId, admissionApplicationId])
  @@unique([tenantId, sectionId, academicYear, rollNumber])
  // =========================================================================
  // 🚀 PERFORMANCE INDEXES (Optimized for Hierarchical Branch Isolation)
  // =========================================================================
  @@index([tenantId, branchId, classId, sectionId]) // ⚡ Fastest Route for Class/Section Sorting
  @@index([tenantId, aadharHash]) // Moved unique lock to index for fluid migrations
  @@index([tenantId, apaarId]) // Moved unique lock to index for fluid migrations
  @@index([tenantId, status])
  @@index([sectionId, rollNumber])
  @@index([tenantId, firstName, lastName])
  @@index([academicYear])
  @@index([aadharLast4])
  @@index([phone])
}
