model PricingPlan {
  id                 String               @id @default(cuid())
  name               String
  code               String               @unique
  category           PlanCategory         @default(SCHOOL)
  tier               SubscriptionTier
  model              PricingModel
  currency           Currency
  region             Region               @default(GLOBAL)
  perStudentRate     Decimal?             @db.Decimal(10, 4)
  prorateEnabled     Boolean              @default(true)
  baseFee            Decimal?             @db.Decimal(12, 2)
  studentLimit       Int?
  overageRate        Decimal?             @db.Decimal(10, 4)
  overageEnabled     Boolean              @default(false)
  branchLimit        Int?
  staffLimit         Int?
  storageLimitGb     Int?
  billingCycleMonths Int                  @default(1)
  trialDays          Int                  @default(30)
  description        String?
  recommended        Boolean              @default(false)
  displayOrder       Int                  @default(0)
  isPublic           Boolean              @default(true)
  version            Int                  @default(1)
  effectiveFrom      DateTime             @default(now())
  effectiveTo        DateTime?
  isActive           Boolean              @default(true)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  deletedAt          DateTime?
  subscriptions      TenantSubscription[]
  features           Json                 @default("{}")
  metadata           Json?

  @@index([region, isActive])
}

model TenantSubscription {
  id                    String                  @id @default(cuid())
  tenantId              String
  isCurrent             Boolean                 @default(true)
  planId                String
  model                 PricingModel
  status                SubscriptionStatus      @default(TRIAL)
  currency              Currency
  currentPeriodStart    DateTime
  currentPeriodEnd      DateTime
  trialEndsAt           DateTime?
  studentCountAtBilling Int?
  lastStudentCountDate  DateTime?
  customPerStudentRate  Decimal?                @db.Decimal(10, 4)
  customBaseFee         Decimal?                @db.Decimal(12, 2)
  gateway               PaymentGatewayProvider?
  gatewayCustomerId     String?
  gatewaySubscriptionId String?
  cancelledAt           DateTime?
  cancelReason          String?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  dunningAttempts       DunningAttempt[]
  saasInvoices          SaasInvoice[]
  plan                  PricingPlan             @relation(fields: [planId], references: [id])
  tenant                Tenant                  @relation(fields: [tenantId], references: [id])
  discountAmount        Decimal?                @db.Decimal(12, 2)
  discountPercent       Decimal?                @db.Decimal(5, 2)
  updatedBy             String?
  startedAt             DateTime                @default(now())
  renewalDate           DateTime?
  autoRenew             Boolean                 @default(true)
  billingEmail          String?
  notes                 String?
  planSnapshot          Json?
  suspendedAt           DateTime?
  endedAt               DateTime?
  createdBy             String?
  priceOverrideReason   String?
  statusChangedAt       DateTime?
  events                SubscriptionEvent[]
  addons                TenantAddon[]

  @@unique([tenantId, isCurrent])
  @@index([status])
  @@index([currentPeriodEnd])
  @@index([tenantId])
  @@index([planId])
  @@index([renewalDate])
  @@index([trialEndsAt])
}

model SaasInvoice {
  id             String             @id @default(cuid())
  subscriptionId String
  invoiceNumber  String             @unique
  status         InvoiceStatus      @default(DRAFT)
  currency       Currency
  subtotal       Decimal            @db.Decimal(12, 2)
  discountAmount Decimal            @default(0) @db.Decimal(12, 2)
  taxAmount      Decimal            @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal            @db.Decimal(12, 2)
  periodStart    DateTime
  periodEnd      DateTime
  studentCount   Int?
  dueDate        DateTime
  paidAt         DateTime?
  pdfUrl         String?
  lineItems      Json?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  subscription   TenantSubscription @relation(fields: [subscriptionId], references: [id])
  saasPayments   SaasPayment[]

  @@index([subscriptionId])
  @@index([status])
}

model SaasPayment {
  id               String                 @id @default(cuid())
  saasInvoiceId    String
  gateway          PaymentGatewayProvider
  gatewayPaymentId String?
  amount           Decimal                @db.Decimal(12, 2)
  currency         Currency
  status           PaymentStatus          @default(PENDING)
  failureReason    String?
  paidAt           DateTime?
  createdAt        DateTime               @default(now())
  saasInvoice      SaasInvoice            @relation(fields: [saasInvoiceId], references: [id])

  @@index([saasInvoiceId])
  @@index([status])
}

model DunningAttempt {
  id             String             @id @default(cuid())
  subscriptionId String
  attemptNumber  Int
  status         DunningStatus      @default(SCHEDULED)
  scheduledAt    DateTime
  executedAt     DateTime?
  action         String
  result         String?
  createdAt      DateTime           @default(now())
  subscription   TenantSubscription @relation(fields: [subscriptionId], references: [id])

  @@index([subscriptionId])
  @@index([scheduledAt])
}

model License {
  id               String        @id @default(cuid())
  key              String        @unique @default(uuid())
  tenantId         String?
  branchId         String?
  issuedById       String?
  subscriptionId   String?
  orderId          String?
  type             LicenseType
  status           LicenseStatus @default(UNUSED)
  version          Int           @default(1)
  maxStudents      Int?
  maxStaff         Int?
  maxBranches      Int?
  storageLimit     Int?
  features         Json?
  domain           String?
  hardwareHash     String?
  metadata         Json?
  expiresAt        DateTime?
  usedAt           DateTime?
  revokedAt        DateTime?
  revocationReason String?
  gracePeriod      Int           @default(7)
  activatedVia     String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  branch           Branch?       @relation(fields: [branchId], references: [id])
  tenant           Tenant?       @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([branchId])
  @@index([subscriptionId])
  @@index([orderId])
  @@index([key, status, expiresAt])
}

model LicenseOrder {
  id        String      @id @default(cuid())
  tenantId  String
  planId    String
  quantity  Int
  status    OrderStatus
  amount    Float
  currency  String
  createdAt DateTime    @default(now())

  @@index([tenantId])
}

model UsageRecord {
  id          String    @id @default(cuid())
  tenantId    String
  branchId    String?
  metric      String
  value       Float
  periodStart DateTime?
  periodEnd   DateTime?
  recordedAt  DateTime  @default(now())

  @@index([tenantId])
}

model SubscriptionEvent {
  id             String                @id @default(cuid())
  subscriptionId String
  tenantId       String
  type           SubscriptionEventType
  oldStatus      SubscriptionStatus?
  newStatus      SubscriptionStatus?
  oldPlanId      String?
  newPlanId      String?
  actorId        String?
  notes          String?
  metadata       Json?
  source         String?
  createdAt      DateTime              @default(now())
  subscription   TenantSubscription    @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  tenant         Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@index([tenantId])
  @@index([type])
  @@index([createdAt])
}

model PricingAddon {
  id           String        @id @default(cuid())
  code         String        @unique
  name         String
  description  String?
  category     AddonCategory
  billingType  BillingType
  amount       Decimal       @db.Decimal(12, 2)
  currency     Currency
  isActive     Boolean       @default(true)
  metadata     Json?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?
  tenantAddons TenantAddon[]

  @@index([category])
  @@index([billingType])
  @@index([isActive])
}

model TenantAddon {
  id             String             @id @default(cuid())
  tenantId       String
  subscriptionId String
  addonId        String
  quantity       Int                @default(1)
  unitPrice      Decimal            @db.Decimal(12, 2)
  status         AddonStatus        @default(ACTIVE)
  startsAt       DateTime           @default(now())
  endsAt         DateTime?
  notes          String?
  metadata       Json?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  deletedAt      DateTime?
  tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription   TenantSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  addon          PricingAddon       @relation(fields: [addonId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([subscriptionId])
  @@index([addonId])
  @@index([status])
}
