model PricingPlan {
  id                 String               @id @default(cuid())
  name               String
  tier               SubscriptionTier
  model              PricingModel
  currency           Currency
  region             Region               @default(GLOBAL)
  perStudentRate     Decimal?             @db.Decimal(10, 4)
  prorateEnabled     Boolean              @default(true)
  baseFee            Decimal?             @db.Decimal(12, 2)
  studentLimit       Int?
  overageRate        Decimal?             @db.Decimal(10, 4)
  overageEnabled     Boolean              @default(false)
  billingCycleMonths Int                  @default(1)
  trialDays          Int                  @default(30)
  isActive           Boolean              @default(true)
  features           Json?                @default("[]")
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  subscriptions      TenantSubscription[]

  @@unique([tier, currency, region, model])
  @@index([region, isActive])
}

model TenantSubscription {
  id                    String                  @id @default(cuid())
  tenantId              String                  @unique
  planId                String
  model                 PricingModel
  status                SubscriptionStatus      @default(TRIAL)
  currency              Currency
  currentPeriodStart    DateTime
  currentPeriodEnd      DateTime
  trialEndsAt           DateTime?
  studentCountAtBilling Int?
  lastStudentCountDate  DateTime?
  customPerStudentRate  Decimal?                @db.Decimal(10, 4)
  customBaseFee         Decimal?                @db.Decimal(12, 2)
  gateway               PaymentGatewayProvider?
  gatewayCustomerId     String?
  gatewaySubscriptionId String?
  cancelledAt           DateTime?
  cancelReason          String?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  dunningAttempts       DunningAttempt[]
  saasInvoices          SaasInvoice[]
  plan                  PricingPlan             @relation(fields: [planId], references: [id])
  tenant                Tenant                  @relation(fields: [tenantId], references: [id])

  @@index([status])
  @@index([currentPeriodEnd])
}

model SaasInvoice {
  id             String             @id @default(cuid())
  subscriptionId String
  invoiceNumber  String             @unique
  status         InvoiceStatus      @default(DRAFT)
  currency       Currency
  subtotal       Decimal            @db.Decimal(12, 2)
  discountAmount Decimal            @default(0) @db.Decimal(12, 2)
  taxAmount      Decimal            @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal            @db.Decimal(12, 2)
  periodStart    DateTime
  periodEnd      DateTime
  studentCount   Int?
  dueDate        DateTime
  paidAt         DateTime?
  pdfUrl         String?
  lineItems      Json?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  subscription   TenantSubscription @relation(fields: [subscriptionId], references: [id])
  saasPayments   SaasPayment[]

  @@index([subscriptionId])
  @@index([status])
}

model SaasPayment {
  id               String                 @id @default(cuid())
  saasInvoiceId    String
  gateway          PaymentGatewayProvider
  gatewayPaymentId String?
  amount           Decimal                @db.Decimal(12, 2)
  currency         Currency
  status           PaymentStatus          @default(PENDING)
  failureReason    String?
  paidAt           DateTime?
  createdAt        DateTime               @default(now())
  saasInvoice      SaasInvoice            @relation(fields: [saasInvoiceId], references: [id])

  @@index([saasInvoiceId])
  @@index([status])
}

model DunningAttempt {
  id             String             @id @default(cuid())
  subscriptionId String
  attemptNumber  Int
  status         DunningStatus      @default(SCHEDULED)
  scheduledAt    DateTime
  executedAt     DateTime?
  action         String
  result         String?
  createdAt      DateTime           @default(now())
  subscription   TenantSubscription @relation(fields: [subscriptionId], references: [id])

  @@index([subscriptionId])
  @@index([scheduledAt])
}
