model PricingPlan {
  id                 String               @id @default(cuid())
  name               String
  code               String               @unique
  category           PlanCategory         @default(SCHOOL)
  tier               SubscriptionTier
  model              PricingModel
  currency           Currency
  region             Region               @default(GLOBAL)
  perStudentRate     Decimal?             @db.Decimal(10, 4)
  prorateEnabled     Boolean              @default(true)
  baseFee            Decimal?             @db.Decimal(12, 2)
  studentLimit       Int?
  overageRate        Decimal?             @db.Decimal(10, 4)
  overageEnabled     Boolean              @default(false)
  branchLimit        Int?
  staffLimit         Int?
  storageLimitGb     Int?
  billingCycleMonths Int                  @default(1)
  trialDays          Int                  @default(30)
  description        String?
  recommended        Boolean              @default(false)
  displayOrder       Int                  @default(0)
  isPublic           Boolean              @default(true)
  version            Int                  @default(1)
  effectiveFrom      DateTime             @default(now())
  effectiveTo        DateTime?
  isActive           Boolean              @default(true)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  deletedAt          DateTime?
  subscriptions      TenantSubscription[]
  features           Json                 @default("{}")
  metadata           Json?

  @@index([region, isActive])
}

model TenantSubscription {
  id                    String                  @id @default(cuid())
  tenantId              String
  isCurrent             Boolean                 @default(true)
  planId                String
  model                 PricingModel
  status                SubscriptionStatus      @default(TRIAL)
  currency              Currency
  currentPeriodStart    DateTime
  currentPeriodEnd      DateTime
  trialEndsAt           DateTime?
  studentCountAtBilling Int?
  lastStudentCountDate  DateTime?
  customPerStudentRate  Decimal?                @db.Decimal(10, 4)
  customBaseFee         Decimal?                @db.Decimal(12, 2)
  gateway               PaymentGatewayProvider?
  gatewayCustomerId     String?
  gatewaySubscriptionId String?
  cancelledAt           DateTime?
  cancelReason          String?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  dunningAttempts       DunningAttempt[]
  saasInvoices          SaasInvoice[]
  plan                  PricingPlan             @relation(fields: [planId], references: [id])
  tenant                Tenant                  @relation(fields: [tenantId], references: [id])
  discountAmount        Decimal?                @db.Decimal(12, 2)
  discountPercent       Decimal?                @db.Decimal(5, 2)
  updatedBy             String?
  startedAt             DateTime                @default(now())
  renewalDate           DateTime?
  autoRenew             Boolean                 @default(true)
  billingEmail          String?
  notes                 String?
  // PR-2 (COMM-004 gap fill): immutable pricing payload captured at
  // subscription create/upgrade time. Populated by onboarding.service.ts.
  // Invoice generation (billing-cycle.processor.ts) reads this instead of
  // the live PricingPlan relation — see ARCH invariant note in ADR COMM-004.
  // Nullable for backward compatibility with subscriptions created before
  // PR-2; those fall back to the live PricingPlan (see processor fallback).
  planSnapshot          Json?
  // PR-2: explicit version pin alongside planSnapshot, for audit/debugging
  // clarity independent of parsing the snapshot payload. No versioning
  // *system* behind this yet (PR-4) -- today it's always plan.version at
  // the single mutable PricingPlan row's current value.
  planVersion           Int?
  suspendedAt           DateTime?
  endedAt               DateTime?
  createdBy             String?
  priceOverrideReason   String?
  statusChangedAt       DateTime?
  events                SubscriptionEvent[]
  addons                TenantAddon[]

  @@unique([tenantId, isCurrent])
  @@index([status])
  @@index([currentPeriodEnd])
  @@index([tenantId])
  @@index([planId])
  @@index([renewalDate])
  @@index([trialEndsAt])
}

model SaasInvoice {
  id             String             @id @default(cuid())
  subscriptionId String
  invoiceNumber  String             @unique
  status         InvoiceStatus      @default(DRAFT)
  currency       Currency
  subtotal       Decimal            @db.Decimal(12, 2)
  discountAmount Decimal            @default(0) @db.Decimal(12, 2)
  taxAmount      Decimal            @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal            @db.Decimal(12, 2)
  periodStart    DateTime
  periodEnd      DateTime
  studentCount   Int?
  dueDate        DateTime
  paidAt         DateTime?
  pdfUrl         String?
  lineItems      Json?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  subscription   TenantSubscription @relation(fields: [subscriptionId], references: [id])
  saasPayments   SaasPayment[]

  @@index([subscriptionId])
  @@index([status])
}

model SaasPayment {
  id               String                 @id @default(cuid())
  saasInvoiceId    String
  gateway          PaymentGatewayProvider
  gatewayPaymentId String?
  amount           Decimal                @db.Decimal(12, 2)
  currency         Currency
  status           PaymentStatus          @default(PENDING)
  failureReason    String?
  paidAt           DateTime?
  createdAt        DateTime               @default(now())
  saasInvoice      SaasInvoice            @relation(fields: [saasInvoiceId], references: [id])

  @@index([saasInvoiceId])
  @@index([status])
}

model DunningAttempt {
  id             String             @id @default(cuid())
  subscriptionId String
  attemptNumber  Int
  status         DunningStatus      @default(SCHEDULED)
  scheduledAt    DateTime
  executedAt     DateTime?
  action         String
  result         String?
  createdAt      DateTime           @default(now())
  subscription   TenantSubscription @relation(fields: [subscriptionId], references: [id])

  @@index([subscriptionId])
  @@index([scheduledAt])
}

model License {
  id                String           @id @default(cuid())
  key               String           @unique @default(uuid())
  tenantId          String?
  branchId          String?
  issuedById        String?
  subscriptionId    String?
  orderId           String?
  type              LicenseType
  status            LicenseStatus    @default(UNUSED)
  version           Int              @default(1)
  // PR-4: increments on every LicenseBuilder.regenerateForTenant() call.
  // Distinct from `version` above (LicenseType/schema version, pre-existing,
  // unrelated) -- generationVersion tracks "which regeneration is this,"
  // making LicenseHistory rows unambiguously orderable without relying on
  // timestamps alone. See LicenseHistory.generationVersion.
  generationVersion Int              @default(1)
  maxStudents       Int?
  maxStaff          Int?
  maxBranches       Int?
  storageLimit      Int?
  features          Json?
  domain            String?
  hardwareHash      String?
  metadata          Json?
  expiresAt         DateTime?
  usedAt            DateTime?
  revokedAt         DateTime?
  revocationReason  String?
  gracePeriod       Int              @default(7)
  activatedVia      String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  branch            Branch?          @relation(fields: [branchId], references: [id])
  tenant            Tenant?          @relation(fields: [tenantId], references: [id])
  history           LicenseHistory[]

  @@index([tenantId])
  @@index([branchId])
  @@index([subscriptionId])
  @@index([orderId])
  @@index([key, status, expiresAt])
}

// PR-4 (ADR COMM-002 gap fill): immutable audit trail for every License
// regeneration. Insert-only -- never updated, never deleted. This is what
// makes "what access did this tenant have on date X" answerable, which is
// the whole reason COMM-002 requires License to be a persisted, versioned
// entity rather than a pure runtime computation.
model LicenseHistory {
  id                 String                  @id @default(cuid())
  licenseId          String
  tenantId           String
  generationVersion  Int
  reason             LicenseGenerationReason
  triggeredBy        String // event name, or a user/admin id for manual actions
  // PR-4 review feedback: explicit, queryable columns rather than only
  // burying these inside planSnapshot's JSON -- ad-hoc audits ("find every
  // history row generated under plan version 3") shouldn't require JSON
  // path queries.
  planId             String?
  planVersion        Int?
  subscriptionId     String?
  subscriptionStatus String?
  // Idempotency key for event-driven callers (e.g. SUBSCRIPTION_ACTIVATED's
  // listener) -- deliberately the SAME string as the EventOutbox row's
  // uniqueKey that produced this regeneration. Null for synchronous
  // callers (onboarding, manual admin) that have no originating event.
  // Nullable+unique is fine in Postgres (multiple NULLs allowed) since only
  // event-driven rows populate it.
  sourceEventKey     String?                 @unique
  effectiveFrom      DateTime                @default(now())
  effectiveTo        DateTime? // set when a later regeneration supersedes this snapshot
  planSnapshot       Json?
  featuresSnapshot   Json?
  limitsSnapshot     Json?
  generatedAt        DateTime                @default(now())

  license License @relation(fields: [licenseId], references: [id])

  @@index([licenseId])
  @@index([tenantId])
  @@index([licenseId, generationVersion])
}

model LicenseOrder {
  id        String      @id @default(cuid())
  tenantId  String
  planId    String
  quantity  Int
  status    OrderStatus
  amount    Float
  currency  String
  createdAt DateTime    @default(now())

  @@index([tenantId])
}

model UsageRecord {
  id          String    @id @default(cuid())
  tenantId    String
  branchId    String?
  metric      String
  value       Float
  periodStart DateTime?
  periodEnd   DateTime?
  recordedAt  DateTime  @default(now())

  @@index([tenantId])
}

model SubscriptionEvent {
  id             String                @id @default(cuid())
  subscriptionId String
  tenantId       String
  type           SubscriptionEventType
  oldStatus      SubscriptionStatus?
  newStatus      SubscriptionStatus?
  oldPlanId      String?
  newPlanId      String?
  actorId        String?
  notes          String?
  metadata       Json?
  source         String?
  createdAt      DateTime              @default(now())
  subscription   TenantSubscription    @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  tenant         Tenant                @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([subscriptionId])
  @@index([tenantId])
  @@index([type])
  @@index([createdAt])
}

model PricingAddon {
  id           String        @id @default(cuid())
  code         String        @unique
  name         String
  description  String?
  category     AddonCategory
  billingType  BillingType
  amount       Decimal       @db.Decimal(12, 2)
  currency     Currency
  isActive     Boolean       @default(true)
  metadata     Json?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?
  tenantAddons TenantAddon[]

  @@index([category])
  @@index([billingType])
  @@index([isActive])
}

model TenantAddon {
  id             String             @id @default(cuid())
  tenantId       String
  subscriptionId String
  addonId        String
  quantity       Int                @default(1)
  unitPrice      Decimal            @db.Decimal(12, 2)
  status         AddonStatus        @default(ACTIVE)
  startsAt       DateTime           @default(now())
  endsAt         DateTime?
  notes          String?
  metadata       Json?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  deletedAt      DateTime?
  tenant         Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  subscription   TenantSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  addon          PricingAddon       @relation(fields: [addonId], references: [id], onDelete: Restrict)

  @@index([tenantId])
  @@index([subscriptionId])
  @@index([addonId])
  @@index([status])
}
