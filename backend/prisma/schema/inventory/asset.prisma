model asset {
  id       String @id @default(cuid())
  tenantId String

  name        String
  category    String?
  description String?

  purchaseDate DateTime?
  cost         Float?

  isActive Boolean @default(true)

  maintenanceLogs maintenanceLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([tenantId])
  @@index([category])
}
