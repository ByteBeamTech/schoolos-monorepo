model FeePlan {
  id           String          @id @default(cuid())
  tenantId     String
  sessionId    String
  branchId     String
  name         String
  description  String?
  academicYear String
  grade        String?
  currency     Currency        @default(INR)
  isActive     Boolean         @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  assignments  FeeAssignment[]
  lateFeeRules LateFeeRule[]
  feeItems     FeeItem[]

  session AcademicSession @relation(fields: [sessionId], references: [id])
  branch  Branch          @relation(fields: [branchId], references: [id])

  @@unique([tenantId, branchId, name, academicYear])
  @@index([tenantId])
  @@index([tenantId, branchId])
}

model FeeItem {
  id           String        @id @default(cuid())
  feePlanId    String
  name         String
  amount       Decimal       @db.Decimal(12, 2)
  isOptional   Boolean       @default(false)
  dueDate      DateTime?     // deprecated in favour of BillingPeriod (Phase 3's
                              // pure runtime calculation) -- kept nullable, not
                              // dropped, since existing rows and any code still
                              // reading it must not break. Removed only once
                              // nothing queries it anymore.
  gstRate      Decimal?      @db.Decimal(5, 2)
  gstCode      String?
  sortOrder    Int           @default(0)
  createdAt    DateTime      @default(now())

  // Phase 2: closes the FeeHead/FeeItem disconnection the original gap
  // analysis found. Both nullable at the database level -- existing rows
  // stay valid with no forced backfill; application-level validation (not
  // a NOT NULL constraint) requires both on new writes going forward.
  feeHeadId      String?
  billingRuleId  String?
  effectiveFrom  DateTime?
  effectiveUntil DateTime?

  feePlan      FeePlan       @relation(fields: [feePlanId], references: [id])
  feeHead      FeeHead?      @relation(fields: [feeHeadId], references: [id])
  billingRule  BillingRule?  @relation(fields: [billingRuleId], references: [id])
  invoiceItems InvoiceItem[]

  @@index([feeHeadId])
  @@index([billingRuleId])
}

// Phase 2 (Billing Domain Model / PHASE_2_REVISED_REUSE_CLASSIFICATION.md):
// genuinely new, no existing analog. Create-only, per frozen business rule --
// a BillingRule referenced by an active FeePlan never changes. A permanent
// policy revision is expressed as a new FeePlan for the next Academic
// Session (or immediately, for a correction caught before any invoice has
// been generated from it -- FeePlan creation was never restricted to
// session boundaries). Temporary concessions route through the existing
// LateFeeRule mechanism entirely, never through this model. No update(),
// no supersede(), no effectiveUntil/isActive/supersededById -- there is
// nothing for any of them to do under this rule.
// Corrective fix: BillingRule was missing branchId entirely (an omission,
// not a deliberate decision -- confirmed against LateFeeRule, the exact
// model this create-only design cited as its pattern, which already has
// this field). Nullable, matching LateFeeRule's own scoping precedent:
// null = tenant-wide default, usable by every branch; non-null = scoped
// to exactly one branch. A FeeItem may reference a tenant-wide rule or
// its own branch's rule, never another branch's -- enforced in
// FeePlansService.createFeeItem()/supersedeFeeItem(), not here.
model BillingRule {
  id             String                   @id @default(cuid())
  tenantId       String
  branchId       String?
  frequency      BillingFrequency
  billingMonths  Int[]
  dueDayOfMonth  Int
  prorationRule  ProrationRule            @default(NO_PRORATION)
  createdAt      DateTime                 @default(now())

  tenant         Tenant    @relation(fields: [tenantId], references: [id])
  branch         Branch?   @relation(fields: [branchId], references: [id])
  feeComponents  FeeItem[]

  @@index([tenantId])
  @@index([tenantId, branchId])
}

model FeeAssignment {
  id           String   @id @default(cuid())
  tenantId     String
  studentId    String
  branchId     String
  feePlanId    String
  academicYear String
  assignedAt   DateTime @default(now())
  assignedBy   String
  feePlan      FeePlan  @relation(fields: [feePlanId], references: [id])
  student      Student  @relation(fields: [studentId], references: [id])
  branch       Branch   @relation(fields: [branchId], references: [id])

  @@unique([studentId, feePlanId, academicYear])
  @@index([tenantId])
  @@index([tenantId, branchId])
}
