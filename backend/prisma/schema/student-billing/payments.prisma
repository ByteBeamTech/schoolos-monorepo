model Payment {
  id               String                 @id @default(cuid())
  tenantId         String
  branchId         String
  invoiceId        String
  gateway          PaymentGatewayProvider
  gatewayOrderId   String?
  gatewayPaymentId String?
  gatewaySignature String?
  amount           Decimal                @db.Decimal(12, 2)
  currency         Currency               @default(INR)
  status           PaymentStatus          @default(PENDING)
  paymentMethod    String?
  payerName        String?
  payerEmail       String?
  payerPhone       String?
  failureReason    String?
  webhookPayload   Json?
  paidAt           DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  invoice          Invoice                @relation(fields: [invoiceId], references: [id])
  branch           Branch                 @relation(fields: [branchId], references: [id])
  receipt          Receipt?
  refunds          Refund[]

  // FEE-1 (IMM-017/018): idempotency for payment recording. gatewayPaymentId
  // holds the payment's external identity -- the gateway payment id online, a
  // stable derived-or-supplied reference offline -- so the same logical
  // payment can only be recorded once per invoice. NULL is permitted many
  // times (Postgres does not treat NULLs as equal), which is required because
  // an online payment has no gatewayPaymentId until it is verified.
  @@unique([tenantId, invoiceId, gatewayPaymentId])
  @@index([tenantId])
  @@index([tenantId, branchId])
  @@index([invoiceId])
  @@index([status])
  @@index([gatewayPaymentId])
}

model Receipt {
  id             String    @id @default(cuid())
  tenantId       String
  branchId       String
  // FEE-1: invoiceId is deliberately NOT unique. The correct ownership rule is
  // one receipt per PAYMENT; one receipt per INVOICE made it impossible to
  // receipt a second payment against the same invoice (instalments / partial
  // payments). paymentId @unique is the real invariant and must be preserved
  // (IMPLEMENTATION_HANDOFF.md §10).
  invoiceId      String
  paymentId      String    @unique
  receiptNumber  String
  amount         Decimal   @db.Decimal(12, 2)
  currency       Currency  @default(INR)
  pdfUrl         String?
  emailSentAt    DateTime?
  whatsappSentAt DateTime?
  createdAt      DateTime  @default(now())
  invoice        Invoice   @relation(fields: [invoiceId], references: [id])
  payment        Payment   @relation(fields: [paymentId], references: [id])
  branch         Branch    @relation(fields: [branchId], references: [id])

  @@unique([tenantId, branchId, receiptNumber])
  @@index([tenantId])
  @@index([tenantId, branchId])
  // Replaces the lookup path the dropped unique index used to provide:
  // "all receipts for this invoice" is a real query (Receipt.invoice relation,
  // and receipt listing per invoice).
  @@index([invoiceId])
}

model Refund {
  id              String                 @id @default(cuid())
  tenantId        String
  branchId        String
  paymentId       String
  amount          Decimal                @db.Decimal(12, 2)
  reason          String
  status          RefundStatus           @default(PENDING)
  gatewayRefundId String?
  gateway         PaymentGatewayProvider
  initiatedBy     String
  processedAt     DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  payment         Payment                @relation(fields: [paymentId], references: [id])

  branch Branch @relation(fields: [branchId], references: [id])

  @@index([tenantId, branchId])
  @@index([tenantId])
  @@index([paymentId])
}
