model Invoice {
  id             String        @id @default(cuid())
  tenantId       String
  branchId       String
  studentId      String
  invoiceNumber  String
  academicYear   String
  status         InvoiceStatus @default(DRAFT)
  currency       Currency      @default(INR)
  subtotal       Decimal       @db.Decimal(12, 2)
  discountAmount Decimal       @default(0) @db.Decimal(12, 2)
  gstAmount      Decimal       @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal       @db.Decimal(12, 2)
  paidAmount     Decimal       @default(0) @db.Decimal(12, 2)
  dueAmount      Decimal       @db.Decimal(12, 2)
  issuedAt       DateTime      @default(now())
  dueDate        DateTime
  paidAt         DateTime?
  pdfUrl         String?
  notes          String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  student        Student       @relation(fields: [studentId], references: [id])
  branch         Branch        @relation(fields: [branchId], references: [id])
  items          InvoiceItem[]
  lateFees       LateFee[]
  billingRunAttempts BillingRunAttempt[]
  payments       Payment[]
  // FEE-1: an invoice may have MANY receipts -- one per payment. This was
  // Receipt? (one-to-one), the back-relation of Receipt.invoiceId @unique.
  // Both sides of a Prisma relation declare its arity, so dropping that
  // @unique without changing this side is a schema validation error (P1012),
  // not merely a style mismatch. Named `receipts` to match the plural list
  // relations alongside it (items, lateFees, payments).
  receipts       Receipt[]

  @@unique([tenantId, branchId, invoiceNumber])
  @@index([tenantId, branchId])
  @@index([tenantId])
  @@index([studentId])
  @@index([status])
  @@index([dueDate])
}

model InvoiceItem {
  id             String   @id @default(cuid())
  invoiceId      String
  feeItemId      String?
  name           String
  amount         Decimal  @db.Decimal(12, 2)
  discountAmount Decimal  @default(0) @db.Decimal(12, 2)
  gstRate        Decimal? @db.Decimal(5, 2)
  gstAmount      Decimal  @default(0) @db.Decimal(12, 2)
  netAmount      Decimal  @db.Decimal(12, 2)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  feeItem        FeeItem? @relation(fields: [feeItemId], references: [id])
  invoice        Invoice  @relation(fields: [invoiceId], references: [id])
  chargeCategory String   @default("ACADEMIC")

  // M9: nullable during transition (frozen spec, explicit). Existing rows
  // are back-linked by migration where chargeCategory maps unambiguously
  // to a seeded default head; the free-text chargeCategory field itself
  // is retained until M23, not replaced here.
  feeHeadId String?
  feeHead   FeeHead? @relation(fields: [feeHeadId], references: [id])

  @@index([invoiceId])
  @@index([feeHeadId])
}
