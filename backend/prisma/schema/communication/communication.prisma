model Announcement {
  id          String    @id @default(cuid())
  tenantId    String
  title       String
  body        String
  targetRoles Json?
  isPinned    Boolean   @default(false)
  publishedAt DateTime?
  expiresAt   DateTime?
  createdBy   String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([tenantId])
  @@index([publishedAt])
}

model Circular {
  id          String    @id @default(cuid())
  tenantId    String
  title       String
  body        String
  attachments Json?
  targetRoles Json?
  publishedAt DateTime?
  createdBy   String
  createdAt   DateTime  @default(now())

  @@index([tenantId])
}
