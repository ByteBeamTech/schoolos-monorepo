// ============================================================================
// TRN-SCH-001A — Transport Domain: Additive Schema Foundation
// ============================================================================
// Ref: SchoolOS Transport Architecture Freeze v1.1 (frozen)
//      SchoolOS Transport SAD Chapters 1-15 (approved draft)
//
// Status: ADDITIVE ONLY.
// This file introduces the target Transport domain model (SAD Ch.3-7)
// alongside the legacy schema in ./transport.prisma. Nothing in
// ./transport.prisma is modified, renamed, or removed by this file.
//
//   - TransportRoute / TransportAssignment (legacy)      -> untouched
//   - Route / RouteStop / Stop / StudentTransportAssignment (target) -> new
//
// Legacy <-> target coexistence, Finance coupling migration, and cleanup
// of legacy columns/models are out of scope here per the approved
// migration strategy (Additive Coexistence, Phase 1). See:
//   - Governance Addendum, "Architecture Freeze Status": Domain Model Frozen
//   - Governance Addendum, Governance Rules -> ADR Required: New Aggregate
//   - SAD Ch.15 ADR-004 / ADR-005 (Transport/Finance boundary — NOT
//     refactored in this task; InvoiceService keeps using the legacy
//     TransportAssignment model until TransportPricingService ships)
//
// No API changes. No service refactoring. No finance refactoring.
// No frontend changes. No breaking migrations.
// ============================================================================

// ----------------------------------------------------------------------------
// Enums — state machines (AF-003) and supporting classifications
// ----------------------------------------------------------------------------

// AF-003: Route requires an explicit lifecycle (SAD Ch.4: Draft/Active/Suspended/Archived)
enum RouteStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  ARCHIVED
}

// AF-003: Trip requires an explicit lifecycle (SAD Ch.8 API: Schedule/Start/Complete/Cancel)
enum TripStatus {
  SCHEDULED
  RUNNING
  COMPLETED
  CANCELLED
}

// AF-003: Student Assignment requires an explicit lifecycle (SAD Ch.5)
enum StudentTransportAssignmentStatus {
  ACTIVE
  TRANSFERRED
  ENDED
}

// AF-003: Vehicle requires an explicit lifecycle (SAD Ch.6: Active, Maintenance, Retired)
enum VehicleStatus {
  ACTIVE
  MAINTENANCE
  RETIRED
}

enum VehicleFuelType {
  DIESEL
  PETROL
  CNG
  ELECTRIC
  HYBRID
  OTHER
}

// SAD Ch.5: Morning Trips / Evening Trips / Special Trips
enum TripType {
  MORNING
  EVENING
  SPECIAL
}

enum TripBoardingType {
  PICKUP
  DROP
}

enum TripAttendanceStatus {
  BOARDED
  ABSENT
  NOT_MARKED
}

// SAD Ch.6: Generic ComplianceItem supports these compliance categories
enum ComplianceItemType {
  INSURANCE
  FITNESS_CERTIFICATE
  PERMIT
  POLLUTION_CERTIFICATE
  ROAD_TAX
  FIRE_EXTINGUISHER
  FIRST_AID_KIT
}

// Extensible on purpose ("Generic ComplianceItem", SAD Ch.6) — VEHICLE is the
// only entity type in scope today; adding a value later is additive.
enum ComplianceEntityType {
  VEHICLE
}

enum MaintenanceType {
  PREVENTIVE
  BREAKDOWN
}

enum TripIncidentSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// ----------------------------------------------------------------------------
// Planning bounded context (SAD Ch.3, Ch.4)
// ----------------------------------------------------------------------------

model Stop {
  id        String    @id @default(cuid())
  tenantId  String
  branchId  String?
  name      String
  landmark  String?
  latitude  Decimal?  @db.Decimal(9, 6)
  longitude Decimal?  @db.Decimal(9, 6)
  stopGroup String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant Tenant  @relation(fields: [tenantId], references: [id])
  branch Branch? @relation(fields: [branchId], references: [id])

  routeStops RouteStop[]

  @@index([tenantId])
  @@index([tenantId, branchId])
}

// Route is the Planning Aggregate Root (SAD Ch.15 ADR-001: RouteStop cannot
// exist independently of Route).
model Route {
  id          String      @id @default(cuid())
  tenantId    String
  branchId    String?
  name        String
  description String?
  status      RouteStatus @default(DRAFT)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?

  tenant Tenant  @relation(fields: [tenantId], references: [id])
  branch Branch? @relation(fields: [branchId], references: [id])

  routeStops         RouteStop[]
  tripSchedules      TripSchedule[]
  trips              Trip[]
  studentAssignments StudentTransportAssignment[]

  @@index([tenantId])
  @@index([tenantId, branchId])
  @@index([status])
}

// Represents the relationship between a Route and a physical Stop.
// Responsibilities per SAD Ch.4: Sequence, Distance, ETA, Boarding Order.
model RouteStop {
  id                  String    @id @default(cuid())
  tenantId            String
  routeId             String
  stopId              String
  sequence            Int
  distanceFromStartKm Decimal?  @db.Decimal(6, 2)
  etaMinutesFromStart  Int?
  boardingOrder       Int?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  route  Route  @relation(fields: [routeId], references: [id])
  stop   Stop   @relation(fields: [stopId], references: [id])

  pricing           TransportStopPricing[]
  pickupAssignments StudentTransportAssignment[] @relation("PickupRouteStop")
  dropAssignments   StudentTransportAssignment[] @relation("DropRouteStop")

  @@unique([routeId, stopId])
  @@index([tenantId])
  @@index([routeId])
  @@index([stopId])
}

// Pricing belongs to RouteStop (SAD Ch.15 ADR-002: same physical Stop may
// have different prices on different Routes). Effective dating per ADR-006.
model TransportStopPricing {
  id            String    @id @default(cuid())
  tenantId      String
  routeStopId   String
  feeAmount     Decimal   @db.Decimal(12, 2)
  currency      Currency  @default(INR)
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  routeStop RouteStop @relation(fields: [routeStopId], references: [id])

  @@index([tenantId])
  @@index([routeStopId])
  @@index([effectiveFrom, effectiveTo])
}

// ----------------------------------------------------------------------------
// Target Student Assignment (SAD Ch.5) — additive, coexists with the legacy
// `TransportAssignment` model (studentId @unique, no effective dating).
// Legacy -> target data migration is a dedicated future migration phase.
// ----------------------------------------------------------------------------

model StudentTransportAssignment {
  id                String                            @id @default(cuid())
  tenantId          String
  branchId          String?
  studentId         String
  routeId           String
  pickupRouteStopId String
  dropRouteStopId   String
  effectiveFrom     DateTime                          @default(now())
  effectiveTo       DateTime?
  status            StudentTransportAssignmentStatus  @default(ACTIVE)
  createdAt         DateTime                          @default(now())
  updatedAt         DateTime                          @updatedAt

  tenant          Tenant    @relation(fields: [tenantId], references: [id])
  branch          Branch?   @relation(fields: [branchId], references: [id])
  student         Student   @relation(fields: [studentId], references: [id])
  route           Route     @relation(fields: [routeId], references: [id])
  pickupRouteStop RouteStop @relation("PickupRouteStop", fields: [pickupRouteStopId], references: [id])
  dropRouteStop   RouteStop @relation("DropRouteStop", fields: [dropRouteStopId], references: [id])

  @@index([tenantId])
  @@index([studentId])
  @@index([routeId])
  @@index([effectiveFrom, effectiveTo])
}

// ----------------------------------------------------------------------------
// Fleet bounded context (SAD Ch.3, Ch.6) — additive, coexists with legacy
// TransportRoute.vehicleNumber / driverName / driverPhone strings.
// ----------------------------------------------------------------------------

// Vehicle is the Fleet Aggregate Root (SAD Ch.3).
model Vehicle {
  id                  String           @id @default(cuid())
  tenantId            String
  branchId            String?
  registrationNumber  String
  capacity            Int
  fuelType            VehicleFuelType  @default(DIESEL)
  chassisNumber       String?
  engineNumber        String?
  status              VehicleStatus    @default(ACTIVE)
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  deletedAt           DateTime?

  tenant Tenant  @relation(fields: [tenantId], references: [id])
  branch Branch? @relation(fields: [branchId], references: [id])

  trips              Trip[]
  fuelLogs           FuelLog[]
  maintenanceRecords Maintenance[]
  complianceItems    ComplianceItem[]
  tripIncidents      TripIncident[]

  @@unique([tenantId, registrationNumber])
  @@index([tenantId])
  @@index([tenantId, branchId])
}

model Driver {
  id                String    @id @default(cuid())
  tenantId          String
  branchId          String?
  name              String
  phone             String?
  licenseNumber     String
  licenseExpiryDate DateTime?
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  tenant Tenant  @relation(fields: [tenantId], references: [id])
  branch Branch? @relation(fields: [branchId], references: [id])

  trips         Trip[]
  tripIncidents TripIncident[]

  @@unique([tenantId, licenseNumber])
  @@index([tenantId])
  @@index([tenantId, branchId])
}

model Conductor {
  id        String    @id @default(cuid())
  tenantId  String
  branchId  String?
  name      String
  phone     String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  tenant Tenant  @relation(fields: [tenantId], references: [id])
  branch Branch? @relation(fields: [branchId], references: [id])

  trips Trip[]

  @@index([tenantId])
  @@index([tenantId, branchId])
}

// ----------------------------------------------------------------------------
// Operations bounded context (SAD Ch.3, Ch.5)
// ----------------------------------------------------------------------------

// Recurring trip definition. AF-004 Daily Trip Generation job materializes
// dated Trip rows from active TripSchedules.
model TripSchedule {
  id            String   @id @default(cuid())
  tenantId      String
  branchId      String?
  routeId       String
  tripType      TripType
  departureTime String // "HH:mm", local to Tenant.timezone
  daysOfWeek    Int[] // 0=Sunday .. 6=Saturday
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  tenant Tenant  @relation(fields: [tenantId], references: [id])
  branch Branch? @relation(fields: [branchId], references: [id])
  route  Route   @relation(fields: [routeId], references: [id])

  trips Trip[]

  @@index([tenantId])
  @@index([routeId])
}

// Trip is the Operations Aggregate Root (SAD Ch.3). Vehicle, Driver and
// Conductor are assigned at Trip level (SAD Ch.15 ADR-003: supports
// replacements and multiple trips per day).
model Trip {
  id             String     @id @default(cuid())
  tenantId       String
  branchId       String?
  routeId        String
  tripScheduleId String?
  vehicleId      String?
  driverId       String?
  conductorId    String?
  tripType       TripType
  tripDate       DateTime   @db.Date
  status         TripStatus @default(SCHEDULED)
  startedAt      DateTime?
  completedAt    DateTime?
  cancelledAt    DateTime?
  cancelReason   String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  branch       Branch?       @relation(fields: [branchId], references: [id])
  route        Route         @relation(fields: [routeId], references: [id])
  tripSchedule TripSchedule? @relation(fields: [tripScheduleId], references: [id])
  vehicle      Vehicle?      @relation(fields: [vehicleId], references: [id])
  driver       Driver?       @relation(fields: [driverId], references: [id])
  conductor    Conductor?    @relation(fields: [conductorId], references: [id])

  attendance TripAttendance[]
  incidents  TripIncident[]

  @@unique([tripScheduleId, tripDate])
  @@index([tenantId])
  @@index([routeId])
  @@index([vehicleId])
  @@index([tripDate])
  @@index([status])
}

model TripAttendance {
  id           String                @id @default(cuid())
  tenantId     String
  tripId       String
  studentId    String
  boardingType TripBoardingType
  status       TripAttendanceStatus  @default(NOT_MARKED)
  markedAt     DateTime?
  markedBy     String?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  trip    Trip    @relation(fields: [tripId], references: [id])
  student Student @relation(fields: [studentId], references: [id])

  @@unique([tripId, studentId, boardingType])
  @@index([tenantId])
  @@index([tripId])
  @@index([studentId])
}

model TripIncident {
  id              String                @id @default(cuid())
  tenantId        String
  tripId          String
  vehicleId       String?
  driverId        String?
  severity        TripIncidentSeverity  @default(LOW)
  description     String
  reportedBy      String?
  reportedAt      DateTime              @default(now())
  resolvedAt      DateTime?
  resolutionNotes String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  tenant  Tenant   @relation(fields: [tenantId], references: [id])
  trip    Trip     @relation(fields: [tripId], references: [id])
  vehicle Vehicle? @relation(fields: [vehicleId], references: [id])
  driver  Driver?  @relation(fields: [driverId], references: [id])

  @@index([tenantId])
  @@index([tripId])
}

// ----------------------------------------------------------------------------
// Fleet support: Fuel, Maintenance, Compliance (SAD Ch.6)
// ----------------------------------------------------------------------------

model FuelLog {
  id              String   @id @default(cuid())
  tenantId        String
  vehicleId       String
  odometerReading Decimal  @db.Decimal(10, 2)
  fuelQuantity    Decimal  @db.Decimal(8, 2)
  fuelCost        Decimal  @db.Decimal(12, 2)
  currency        Currency @default(INR)
  filledAt        DateTime @default(now())
  filledBy        String?
  station         String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  tenant  Tenant  @relation(fields: [tenantId], references: [id])
  vehicle Vehicle @relation(fields: [vehicleId], references: [id])

  @@index([tenantId])
  @@index([vehicleId])
  @@index([filledAt])
}

// Vendor Management (SAD Ch.6) reuses the existing VendorProfile model
// (vendor-management/vendor.prisma) rather than introducing a parallel
// vendor concept.
model Maintenance {
  id              String          @id @default(cuid())
  tenantId        String
  vehicleId       String
  type            MaintenanceType
  vendorId        String?
  description     String
  cost            Decimal?        @db.Decimal(12, 2)
  currency        Currency        @default(INR)
  odometerReading Decimal?        @db.Decimal(10, 2)
  scheduledAt     DateTime?
  completedAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  tenant  Tenant         @relation(fields: [tenantId], references: [id])
  vehicle Vehicle        @relation(fields: [vehicleId], references: [id])
  vendor  VendorProfile? @relation(fields: [vendorId], references: [id])

  @@index([tenantId])
  @@index([vehicleId])
}

// Generic ComplianceItem (SAD Ch.6): Insurance, Fitness Certificate, Permit,
// PUC, Road Tax, Fire Extinguisher, First Aid Kit. Expiry/compliance status
// (valid / expiring-soon / expired) is a computed predicate derived from
// expiryDate at read time by the AF-004 Compliance Expiry monitoring job —
// never persisted, consistent with the OVERDUE convention already
// established for Finance (computed states are not stored as columns).
model ComplianceItem {
  id              String               @id @default(cuid())
  tenantId        String
  entityType      ComplianceEntityType @default(VEHICLE)
  vehicleId       String?
  itemType        ComplianceItemType
  referenceNumber String?
  issuedDate      DateTime?
  expiryDate      DateTime
  documentUrl     String?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  tenant  Tenant   @relation(fields: [tenantId], references: [id])
  vehicle Vehicle? @relation(fields: [vehicleId], references: [id])

  @@index([tenantId])
  @@index([vehicleId])
  @@index([expiryDate])
}
