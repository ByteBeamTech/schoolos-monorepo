model StudentPromotion {
  id            String          @id @default(cuid())
  tenantId      String
  studentId     String
  fromSessionId String
  toSessionId   String
  fromSectionId String
  toSectionId   String?
  status        PromotionStatus @default(PENDING)
  promotionType PromotionType
  averageMarks  Float?
  passingMarks  Float?
  remarks       String?
  processedBy   String
  processedAt   DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([tenantId])
  @@index([studentId])
  @@index([fromSessionId])
}

model PromotionRule {
  id             String   @id @default(cuid())
  tenantId       String
  sessionId      String
  fromClassId    String
  toClassId      String
  passingMarks   Float    @default(33)
  requireAllPass Boolean  @default(false)
  autoPromote    Boolean  @default(false)
  createdBy      String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  tenant         Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, sessionId, fromClassId])
  @@index([tenantId])
}

model StudentMigration {
  id               String          @id @default(cuid())
  tenantId         String
  studentId        String
  targetSchoolName String
  targetSchoolCode String?
  migrationDate    DateTime
  transferCertUrl  String?
  reason           String?
  status           MigrationStatus @default(PENDING)
  approvedBy       String?
  approvedAt       DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([tenantId])
  @@index([studentId])
}

model IDCard {
  id             String       @id @default(cuid())
  tenantId       String
  entityType     IDCardType
  entityId       String
  cardNumber     String
  qrCode         String
  issueDate      DateTime     @default(now())
  expiryDate     DateTime
  templateId     String?
  photoUrl       String?
  status         IDCardStatus @default(ACTIVE)
  printedAt      DateTime?
  printedBy      String?
  replacedCardId String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  tenant         Tenant       @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, cardNumber])
  @@index([tenantId])
  @@index([entityType, entityId])
  @@index([qrCode])
}

model IDCardTemplate {
  id          String     @id @default(cuid())
  tenantId    String
  name        String
  type        IDCardType
  frontDesign Json
  backDesign  Json?
  width       Int        @default(86)
  height      Int        @default(54)
  isDefault   Boolean    @default(false)
  createdBy   String
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  tenant      Tenant     @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

model Alumni {
  id                String    @id @default(cuid())
  tenantId          String
  studentId         String?
  firstName         String
  lastName          String
  email             String?
  phone             String?
  graduationYear    Int
  lastClass         String
  lastSection       String?
  dateOfBirth       DateTime?
  gender            Gender?
  photoUrl          String?
  currentOccupation String?
  currentCompany    String?
  currentCity       String?
  linkedInUrl       String?
  achievements      Json?
  isVerified        Boolean   @default(false)
  verifiedBy        String?
  metadata          Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  tenant            Tenant    @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([graduationYear])
  @@index([email])
}

enum PromotionStatus {
  PENDING
  PROMOTED
  DETAINED
  MIGRATED
  CANCELLED
}

enum PromotionType {
  PROMOTED
  DETAINED
  MIGRATED
}

enum MigrationStatus {
  PENDING
  APPROVED
  COMPLETED
  CANCELLED
}

enum IDCardType {
  STUDENT
  STAFF
}

enum IDCardStatus {
  ACTIVE
  EXPIRED
  LOST
  REPLACED
  CANCELLED
}
