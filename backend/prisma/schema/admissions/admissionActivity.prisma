model admissionActivity {
  id           String   @id @default(cuid())

  tenantId     String
  admissionId  String

  // 🔹 actor tracking
  actorId      String?

  action       String
  note         String?

  meta         Json?

  createdAt    DateTime @default(now())

  admission Admission @relation(fields: [admissionId], references: [id], onDelete: Cascade)

  @@index([tenantId])
  @@index([admissionId])
  @@index([createdAt])
}
