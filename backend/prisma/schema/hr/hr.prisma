model ApprovalWorkflowConfig {
  id           String   @id @default(cuid())
  tenantId     String
  workflowType String
  levels       Json
  createdBy    String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  tenant       Tenant   @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, workflowType])
  @@index([tenantId])
}

model JoiningRequest {
  id             String            @id @default(cuid())
  tenantId       String
  candidateName  String
  email          String
  phone          String
  position       String
  department     String?
  proposedSalary Decimal?          @db.Decimal(12, 2)
  resumeUrl      String?
  documents      Json?
  notes          String?
  status         String            @default("PENDING")
  currentLevel   Int               @default(1)
  maxLevel       Int               @default(1)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  approvals      JoiningApproval[]
  tenant         Tenant            @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
  @@index([status])
}

model JoiningApproval {
  id               String         @id @default(cuid())
  joiningRequestId String
  level            Int
  approverRole     String
  approverId       String?
  status           String         @default("PENDING")
  comments         String?
  actionAt         DateTime?
  createdAt        DateTime       @default(now())
  joiningRequest   JoiningRequest @relation(fields: [joiningRequestId], references: [id])

  @@unique([joiningRequestId, level])
  @@index([joiningRequestId])
}

model StaffLeave {
  id         String   @id @default(cuid())
  tenantId   String
  staffId    String
  leaveType  String
  fromDate   DateTime
  toDate     DateTime
  totalDays  Int
  reason     String
  status     String   @default("PENDING")
  approvedBy String?
  comments   String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([tenantId])
  @@index([staffId])
}

model LeaveBalance {
  id        String   @id @default(cuid())
  tenantId  String
  staffId   String
  leaveType String
  totalDays Int      @default(0)
  usedDays  Int      @default(0)
  year      Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([tenantId, staffId, leaveType, year])
  @@index([tenantId])
}
